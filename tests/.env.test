# -----------------------------------
#       APP
# -----------------------------------
APP_NAME='Jabba chat-identity (testings)'
APP_VERSION=0.0.0.dev

APP_HOST=http://localhost
APP_PORT=20000
APP_ENVIRONMENT=testing
APP_CONF_DIR_NAME=unit_conf

APP_NETWORKING_PROXIES="127.0.0.1"

# ||||||||||||||||
# Database
# ||||||||||||||||
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=admin
MYSQL_DB=chat_identity_tests
MYSQL_MAX_OPEN_CONNECTIONS=50
MYSQL_MAX_IDLE_CONNECTIONS=25
MYSQL_MAX_CONNECTION_LIFETIME=300
MYSQL_MAX_CONNECTION_IDLE_TIME=600

MONGODB_URI=mongodb://root:pass@localhost:27017
MONGODB_DB=chat_orchestrator_tests

CACHE_SERVICE_PREFIX=chat_session_tests:
CACHE_TTL_SECONDS=120

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASS=
REDIS_MAX_CONNECTIONS=50


# ||||||||||||||||
# AI-Bot Integration
# ||||||||||||||||
AI_BOT_HOST=http://localhost
AI_BOT_PORT=20003
AI_BOT_TIMEOUT_SECONDS=120
AI_BOT_HELLO_MESSAGE=Hello!
